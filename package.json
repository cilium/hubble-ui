{
  "name": "hubble-ui",
  "private": true,
  "config": {
    "protocVersion": "36.1"
  },
  "scripts": {
    "test": "jest",
    "postinstall": "patch-package && bash ./scripts/post-install.sh",
    "watch:server": "servor ./server/public index.html 8080",
    "watch:client": "NODE_ENV=development webpack --progress",
    "watch": "run-p watch:*",
    "build": "run-s check:types build:webpack",
    "build:webpack": "NODE_ENV=production webpack",
    "check:types": "tsc --noEmit",
    "prettier": "prettier --write .",
    "lint": "run-s lint:ts lint:scss",
    "lint:fix": "run-s lint:ts:fix lint:scss:fix",
    "lint:ts": "eslint \"./**/*.{ts,tsx,js,jsx,mjs}\"",
    "lint:ts:fix": "npm run lint:ts -- --fix",
    "lint:scss": "stylelint --ignore-path .gitignore \"./**/*.scss\"",
    "lint:scss:fix": "npm run lint:scss -- --fix",
    "upgrade-deps": "ncu --interactive --format group"
  },
  "lint-staged": {
    "./src/!(proto)/**/*.{ts,tsx,js,jsx,mjs}": [
      "npm run --silent lint:ts:fix"
    ],
    "./src/**/*.scss": [
      "npm run --silent lint:scss:fix"
    ]
  },
  "dependencies": {
    "@babel/runtime": "8.0.0",
    "@blueprintjs/core": "6.18.0",
    "@blueprintjs/icons": "6.13.0",
    "@blueprintjs/select": "6.3.4",
    "@improbable-eng/grpc-web": "0.15.0",
    "@react-hook/resize-observer": "2.0.2",
    "@react-spring/web": "10.1.2",
    "@use-gesture/react": "10.3.1",
    "classnames": "2.5.1",
    "core-js": "3.50.0",
    "d3": "7.9.0",
    "date-fns": "4.4.0",
    "google-protobuf": "4.0.2",
    "history": "5.3.0",
    "lodash": "4.18.1",
    "mobx": "7.0.3",
    "mobx-react": "10.0.2",
    "pluralize": "8.0.0",
    "prop-types": "15.8.1",
    "query-string": "9.5.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.3",
    "react-window": "2.3.0",
    "url-parse": "1.5.10"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@babel/eslint-parser": "8.0.1",
    "@babel/plugin-proposal-decorators": "8.0.2",
    "@babel/plugin-transform-runtime": "8.0.1",
    "@babel/preset-env": "8.0.2",
    "@babel/preset-react": "8.0.1",
    "@babel/preset-typescript": "8.0.1",
    "@blueprintjs/node-build-scripts": "10.0.0",
    "@protobuf-ts/plugin": "2.11.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/d3": "7.4.3",
    "@types/google-protobuf": "3.15.12",
    "@types/jest": "30.0.0",
    "@types/lodash": "4.17.25",
    "@types/object-hash": "3.0.6",
    "@types/pluralize": "0.0.33",
    "@types/prop-types": "15.7.15",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/react-test-renderer": "19.1.0",
    "@types/route-parser": "0.1.7",
    "@types/url-parse": "1.4.11",
    "ajv": "8.20.0",
    "autoprefixer": "10.5.4",
    "babel-jest": "30.5.1",
    "babel-loader": "10.1.1",
    "css-loader": "7.1.5",
    "dotenv-webpack": "9.0.0",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "fflate": "0.8.3",
    "fs-extra": "11.4.0",
    "html-webpack-plugin": "5.6.8",
    "identity-obj-proxy": "3.0.0",
    "jest": "30.5.1",
    "jest-environment-jsdom": "30.5.1",
    "lint-staged": "17.4.1",
    "mini-css-extract-plugin": "2.10.2",
    "node-fetch": "3.3.2",
    "npm-check-updates": "23.1.0",
    "npm-run-all2": "9.0.3",
    "patch-package": "8.0.1",
    "prettier": "3.9.6",
    "react-test-renderer": "19.2.8",
    "sass": "1.103.1",
    "sass-loader": "17.0.1",
    "servor": "4.0.2",
    "source-map-explorer": "2.5.3",
    "source-map-loader": "5.0.0",
    "stylelint": "17.14.1",
    "stylelint-config-css-modules": "4.6.0",
    "stylelint-config-prettier-scss": "1.0.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-scss": "7.2.0",
    "ts-node": "10.9.2",
    "ts-protoc-gen": "0.15.0",
    "tsconfig-paths-webpack-plugin": "4.2.0",
    "typescript": "7.0.2",
    "webpack": "5.110.3",
    "webpack-cli": "7.2.3",
    "webpack-dev-server": "6.0.0"
  }
}
