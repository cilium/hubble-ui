{
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "declaration": true,
    "module": "esnext",
    "target": "esnext",
    "lib": ["dom", "esnext"],
    "rootDir": "./",
    "outDir": "./build",
    "jsx": "react",
    "paths": {
      "~/*": ["./src/*"],
      "~backend/*": ["./backend/*"]
    },
    "types": ["node", "jest"],
    "moduleResolution": "bundler",
    "isolatedModules": false,
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "strictBindCallApply": true,
    "strictFunctionTypes": true,
    "strictPropertyInitialization": true,
    "strictNullChecks": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "exclude": ["node_modules", "src/testing/e2e"],
  "include": ["src/**/*", "src/**/*.json", "backend/proto/**/*.ts"]
}
